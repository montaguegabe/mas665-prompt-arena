{
  "manifest": {
    "tools": [
      {
        "name": "calendar.create_event",
        "description": "Create a calendar event or reminder at a specific date and time.",
        "args": {
          "title": {
            "type": "string",
            "required": true,
            "description": "Event title"
          },
          "start": {
            "type": "string",
            "required": true,
            "description": "Start as ISO 8601 local datetime, e.g. 2026-11-05T14:00"
          },
          "end": {
            "type": "string",
            "required": false,
            "description": "End as ISO 8601 local datetime"
          },
          "attendees": {
            "type": "array",
            "items": "string",
            "required": false,
            "description": "Attendee email addresses"
          }
        }
      },
      {
        "name": "email.send",
        "description": "Send an email.",
        "args": {
          "to": {
            "type": "string",
            "required": true,
            "description": "Recipient email address"
          },
          "subject": {
            "type": "string",
            "required": true
          },
          "body": {
            "type": "string",
            "required": true
          }
        }
      },
      {
        "name": "email.search",
        "description": "Search the user's mailbox, including message attachments.",
        "args": {
          "query": {
            "type": "string",
            "required": true,
            "description": "Free-text search terms"
          },
          "from": {
            "type": "string",
            "required": false,
            "description": "Sender email address"
          },
          "since": {
            "type": "string",
            "required": false,
            "description": "Only messages on or after this ISO date, e.g. 2026-10-01"
          }
        }
      },
      {
        "name": "files.search",
        "description": "Search files saved in the user's drive.",
        "args": {
          "query": {
            "type": "string",
            "required": true,
            "description": "Free-text search terms"
          },
          "type": {
            "type": "string",
            "required": false,
            "enum": [
              "pdf",
              "spreadsheet",
              "presentation",
              "image",
              "document"
            ],
            "description": "Restrict to a file type"
          }
        }
      },
      {
        "name": "weather.get",
        "description": "Get current weather or a forecast for a location.",
        "args": {
          "location": {
            "type": "string",
            "required": true,
            "description": "City or place name"
          },
          "date": {
            "type": "string",
            "required": false,
            "description": "ISO date, e.g. 2026-11-06. Omit for current conditions."
          }
        }
      },
      {
        "name": "timer.set",
        "description": "Start a countdown timer for a duration measured from now (e.g. 'in 10 minutes').",
        "args": {
          "duration_seconds": {
            "type": "integer",
            "required": true,
            "description": "Duration in seconds"
          },
          "label": {
            "type": "string",
            "required": false,
            "description": "Short label for the timer"
          }
        }
      },
      {
        "name": "contacts.lookup",
        "description": "Look up a person's phone, email, or address in the user's contacts.",
        "args": {
          "name": {
            "type": "string",
            "required": true,
            "description": "Person's name as written"
          }
        }
      },
      {
        "name": "notes.create",
        "description": "Save a free-text note.",
        "args": {
          "title": {
            "type": "string",
            "required": true
          },
          "body": {
            "type": "string",
            "required": true
          }
        }
      }
    ]
  },
  "cases": [
    {
      "id": "V01",
      "request": "Add a meeting called Budget Review on 2026-11-05 from 14:00 to 15:00.",
      "expected": {
        "tool": "calendar.create_event",
        "args": {
          "title": "Budget Review",
          "start": "2026-11-05T14:00",
          "end": "2026-11-05T15:00"
        }
      },
      "strict": [
        "title"
      ],
      "tags": [
        "calendar",
        "direct"
      ]
    },
